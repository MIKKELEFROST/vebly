{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "functions": {
    "api/udkast.js": {
      "includeFiles": "api/_lib/udkast/**"
    },
    "api/bestil.js": {
      "includeFiles": "api/_lib/udkast/**"
    },
    "api/oensker.js": {
      "includeFiles": "api/_lib/udkast/**"
    }
  },
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "vebly.vercel.app"
        }
      ],
      "destination": "https://webleads.dk/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "webleads.vercel.app"
        }
      ],
      "destination": "https://webleads.dk/$1",
      "permanent": true
    },
    {
      "source": "/referencer",
      "destination": "/resultater",
      "permanent": false
    },
    {
      "source": "/api/_lib/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/services/reklamevideoer",
      "destination": "/services/video",
      "permanent": true
    },
    {
      "source": "/services/reklamevideo",
      "destination": "/services/video",
      "permanent": true
    },
    {
      "source": "/services/explainer-video",
      "destination": "/services/video",
      "permanent": true
    },
    {
      "source": "/services/motion-graphics",
      "destination": "/services/video",
      "permanent": true
    },
    {
      "source": "/services/motion-graphic-videoer",
      "destination": "/services/video",
      "permanent": true
    },
    {
      "source": "/services/crm",
      "destination": "/services/interne-systemer",
      "permanent": true
    },
    {
      "source": "/services/crm-udvikling",
      "destination": "/services/interne-systemer",
      "permanent": true
    },
    {
      "source": "/services/systemer",
      "destination": "/services/interne-systemer",
      "permanent": true
    },
    {
      "source": "/services/app",
      "destination": "/services/app-udvikling",
      "permanent": true
    },
    {
      "source": "/services/apps",
      "destination": "/services/app-udvikling",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/((?!css/|js/).*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(css|js)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(favicon.ico|site.webmanifest)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    },
    {
      "source": "/referencer(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/:kunde([a-z0-9]+(?:-[a-z0-9]+)*)-:side(forside|ydelser|om-os|kontakt|priser|galleri|booking|faq|tilbud)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    },
    {
      "source": "/tak(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/udkast/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/tak/:side([a-z0-9-]+)",
      "destination": "/tak"
    },
    {
      "source": "/mit-udkast",
      "destination": "/api/udkast"
    },
    {
      "source": "/mit-udkast/:side(ydelser|om-os|kontakt)",
      "destination": "/api/udkast?side=:side"
    },
    {
      "source": "/:kunde([a-z0-9]+(?:-[a-z0-9]+)*)-:side(forside|ydelser|om-os|kontakt|priser|galleri|booking|faq|tilbud)",
      "destination": "/udkast/:kunde/:side"
    }
  ]
}
